{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 HDMI 用例（本地模拟）",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "pytest",
            "args": [
                "tests/audio/test_9220_hdmi.py::test_9220_hdmi_volume",
                "-v",
                "-s",
                "-o",
                "addopts=",
                "--iot-config",
                "${workspaceFolder}/config/environments/test.toml",
                "--iot-data",
                "${workspaceFolder}/testdata/audio/hdmi.json"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTEST_ADDOPTS": ""
            }
        }
    ]
}
